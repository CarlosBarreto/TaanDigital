---
// src/components/Services.astro
import "../styles/services.css";

interface Capability {
  icon: string;
  title: string;
  description: string;
  link: string;
}

const capabilities: Capability[] = [
  {
    icon: "query_stats",
    title: "Diagnóstico Inteligente",
    description:
      "Analizamos tu negocio como un sistema completo. Identificamos fricciones, cuellos de botella y oportunidades mediante evaluación estratégica y análisis asistido por IA.",
    link: "#diagnostico",
  },
  {
    icon: "architecture",
    title: "Arquitectura de Soluciones",
    description:
      "Diseñamos procesos, sistemas y flujos tecnológicos que conectan estrategia, operación y datos. Nada se automatiza sin antes tener sentido.",
    link: "#arquitectura",
  },
  {
    icon: "smart_toy",
    title: "Operación Asistida por IA",
    description:
      "Implementamos sistemas que monitorean, aprenden y apoyan la toma de decisiones. La IA se integra como copiloto, no como reemplazo.",
    link: "#operacion",
  },
];
---

<section class="services" id="que-hacemos">
  <div class="services__container">
    <header class="services__header">
      <h2 class="services__title">Qué hacemos</h2>
      <p class="services__subtitle">
        Diseñamos y operamos sistemas inteligentes para que los negocios crezcan
        con orden, claridad y decisiones informadas.
      </p>
    </header>

    <div class="services__grid">
      {
        capabilities.map((capability) => (
          <article class="service-card">
            <span class="material-icons service-card__icon">
              {capability.icon}
            </span>

            <h3 class="service-card__title">{capability.title}</h3>

            <p class="service-card__description">{capability.description}</p>

            <a href={capability.link} class="service-card__link">
              Ver cómo funciona
              <span class="material-icons service-card__link-icon">
                arrow_forward
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
