---
// src/components/CTA.astro
import "../styles/cta.css";

interface DiagnosticFeature {
  icon: string;
  title: string;
  text: string;
}

const features: DiagnosticFeature[] = [
  {
    icon: "query_stats",
    title: "Evaluación Sistémica",
    text: "Analizamos tu negocio como un sistema completo, no como áreas aisladas.",
  },
  {
    icon: "account_tree",
    title: "Mapa de Fricciones",
    text: "Identificamos cuellos de botella, duplicidades y puntos de mejora reales.",
  },
  {
    icon: "insights",
    title: "Ruta Clara de Acción",
    text: "Obtienes un diagnóstico comprensible y un roadmap priorizado.",
  },
];
---

<section class="cta" id="diagnostico">
  <div class="cta__background">
    <div class="cta__circle"></div>
    <div class="cta__circle"></div>
    <div class="cta__circle"></div>
  </div>

  <div class="cta__container">
    <h2 class="cta__title">Diagnóstico Inteligente de tu Negocio</h2>

    <p class="cta__description">
      Antes de proponer soluciones, entendemos tu sistema. Este diagnóstico es
      el primer paso para diseñar procesos, tecnología y decisiones que
      realmente funcionen.
    </p>

    <div class="cta__buttons">
      <a href="/diagnostico" class="cta__button cta__button--primary">
        <span>Iniciar diagnóstico</span>
      </a>

      <a href="#como-trabajamos" class="cta__button cta__button--secondary">
        Cómo funciona
      </a>
    </div>

    <div class="cta__features">
      {
        features.map((feature) => (
          <div class="cta__feature">
            <span class="material-icons cta__feature-icon">{feature.icon}</span>

            <h3 class="cta__feature-title">{feature.title}</h3>

            <p class="cta__feature-text">{feature.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Parallax suave para fondo (mantener estética sin distraer)
  document.addEventListener("mousemove", (e) => {
    const circles = document.querySelectorAll(".cta__circle");
    const mouseX = e.clientX / window.innerWidth;
    const mouseY = e.clientY / window.innerHeight;

    circles.forEach((circle, index) => {
      const speed = (index + 1) * 18;
      const x = (mouseX - 0.5) * speed;
      const y = (mouseY - 0.5) * speed;

      if (circle instanceof HTMLElement) {
        circle.style.transform = `translate(${x}px, ${y}px)`;
      }
    });
  });

  // Reveal on scroll (features)
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target instanceof HTMLElement) {
          entry.target.style.opacity = "1";
          entry.target.style.transform = "translateY(0)";
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll(".cta__feature").forEach((feature) => {
    if (feature instanceof HTMLElement) {
      feature.style.opacity = "0";
      feature.style.transform = "translateY(20px)";
      feature.style.transition = "all 0.6s ease-out";
      observer.observe(feature);
    }
  });
</script>
