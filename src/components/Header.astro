---
// src/components/Header.astro
import "../styles/header.css";
import Logo from "./Logo.astro";

const navItems = [
  "Home",
  "Qué hacemos",
  "IA en Taan",
  "Cómo trabajamos",
  "Manifiesto",
  "Conocimiento",
  "Iniciar diagnóstico",
  "Contáctanos",
];

//const secondaryLinks = [
