---

<header class="header">
  <div class="container header__container">
    <Logo className="header__logo" />

    <nav class="header__nav">
      <ul class="header__nav-list">
        <li><a href="#" class="header__nav-link">Home</a></li>
        <li><a href="#" class="header__nav-link">Qué hacemos</a></li>
        <li><a href="#" class="header__nav-link">IA en Taan</a></li>
        <li><a href="#" class="header__nav-link">Cómo trabajamos</a></li>
        <li><a href="#" class="header__nav-link">Manifiesto</a></li>
        <li><a href="#" class="header__nav-link">Conocimiento</a></li>
        <li><a href="#" class="header__nav-link">Iniciar diagnóstico</a></li>
        <!-- <li><a href="#" class="header__nav-link">eCommerce</a></li> -->
        <li><a href="#" class="header__nav-button">Contáctanos</a></li>
      </ul>
    </nav>

    <button class="header__menu-button">
      <span class="material-icons">menu</span>
    </button>
  </div>

  <!--
  <div class="header__secondary">
    <a href="#" class="header__secondary-link">Bolsa de trabajo</a>
    <a href="#" class="header__secondary-link">Tienda</a>
